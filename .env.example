# Gitee 私人令牌：https://gitee.com/profile/personal_access_tokens
# 需要的权限：projects / issues / releases（只读即可）
GITEE_TOKEN=

# GitHub Fine-grained / Classic Token：https://github.com/settings/tokens
# Classic 需要 repo 权限；Fine-grained 需要 Contents(RW) + Issues(RW) + Metadata(R) + Administration(RW，用于建仓库)
GITHUB_TOKEN=
